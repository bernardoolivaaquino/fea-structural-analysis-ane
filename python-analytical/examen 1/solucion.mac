FINISH
/CLEAR
/PREP7

! --- 1. Définition des Paramètres ---
E_MOD = 30E6          ! Módulo de Young (psi)
A_SEC = 8.0           ! Área (in^2)
F_LOAD = 300.0        ! Carga (lb)

! --- 2. Propriétés Matérielles et Section ---
ET,1,LINK180          ! Élément de type barre (truss)
MP,EX,1,E_MOD
MP,PRXY,1,0.3
SECTYPE,1,LINK
SECDATA,A_SEC

! --- 3. Géométrie (Nœuds) ---
N,1, 0, 0, 0
N,2, 55.15384614, 0, 0
N,3, 27.46153846, 27.46153846, 0
N,4, 41.30769231, 33.23076924, 0
N,5, 27.46153846, 66.46153846, 0

! --- 4. Connectivité (Éléments) ---
E,1,3    ! Élément 1
E,3,2    ! Élément 2
E,2,4    ! Élément 3
E,3,4    ! Élément 4
E,3,5    ! Élément 5
E,4,5    ! Élément 6

! --- 5. Conditions aux Limites et Charges ---
D,1,ALL,0             ! Appui fixe en 1
D,2,ALL,0             ! Appui fixe en 2
F,3,FX,F_LOAD         ! Force de 300 lb en X sur le nœud 3
F,5,FX,F_LOAD         ! Force de 300 lb en X sur le nœud 5

! --- 6. Résolution ---
/SOLU
ANTYPE,0              ! Analyse statique
SOLVE
FINISH

! --- 7. Post-traitement (Affichage des résultats) ---
/POST1
SET,LAST

! Commande pour lister les réactions (Appuis 1 et 2)
/TITLE, REACTIONS AUX APPUIS (lb)
PRRSOL, F

! Commande pour lister les déplacements (Tous les nœuds)
/TITLE, DEPLACEMENTS DES NOEUDS (in)
PRNSOL, U, COMP

! Création d'une table pour extraire les contraintes axiales
ETABLE,ESFUERZO,LS,1
/TITLE, CONTRAINTES DANS LES BARRES (psi)
PRETAB,ESFUERZO

! Représentation graphique des contraintes
PLETAB,ESFUERZO,AVG